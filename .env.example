# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "openai" | "anthropic"
LLM_PROVIDER=openai
# Options (openai): gpt-4o  gpt-4o-mini
# Options (anthropic): claude-haiku-5-5  claude-sonnet-5-5
LLM_MODEL=gpt-4o

# ── Fingerprinting (AudD) ────────────────────────────────────────────────────
# Seconds between samples (min 15). Each sample = 1 AudD request.
# A 1-hour mix: 90s ≈ 40 requests, 60s ≈ 60, 30s ≈ 120.
FINGERPRINT_INTERVAL=90
# Retry unmatched samples once, offset by half the interval (true/false).
FINGERPRINT_SECOND_PASS=true

# ── Transcription Provider ────────────────────────────────────────────────────
# Options: "whisper_api" | "whisper_local" | "assemblyai" | "deepgram"
TRANSCRIPTION_PROVIDER=whisper_api

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# AssemblyAI (if TRANSCRIPTION_PROVIDER=assemblyai)
ASSEMBLYAI_API_KEY=

# Deepgram (if TRANSCRIPTION_PROVIDER=deepgram)
DEEPGRAM_API_KEY=

# ── Music Lookup APIs (optional — omit to skip that source) ───────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Discogs (requires: pip install discogs-client)
DISCOGS_TOKEN=

# SoundCloud (optional — get a client_id from https://developers.soundcloud.com/)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# AudD audio fingerprinting (optional — https://audd.io, 500 free req/month)
AUDD_API_KEY=

# Credentials for my buymusic.club account
BUYMUSIC_CLUB_USERNAME=cutups
BUYMUSIC_CLUB_PASSWORD=Momar129!!